# Obsidian workspace 文件（每台设备布局不同，不共享）
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Obsidian 回收站
.trash/

# 系统临时文件
.DS_Store
Thumbs.db
desktop.ini

# 大型二进制附件（可选：如果附件较小可注释掉下面两行）
# *.mp4
# *.mov
# *.zip
# *.rar
# *.7z

# 日志 / 缓存
logs/
*.log

# 生成的 PDF 备份（由 GitHub Actions 生成；pdf/ 保留为生成目录）
GUIDE.pdf

# 站点页（根目录 + site/ 子目录）需入库供 GitHub Pages 托管；
# 注意：core.ignorecase=true 下大写构建产物 GUIDE.html 会误伤小写 guide.html，
# 故构建产物改用单独命名，站点页统一入库
!index.html
!guide.html
!best-practices.html
!site/index.html
!site/guide.html
!site/best-practices.html
build/GUIDE.html

# 本地截图（正式版存资料库）
screenshots/

# 打包产物（含大文件，不入库）
打包/

# 敏感信息（建议用环境变量或加密笔记，不要提交明文）
# .env
# *.secret
